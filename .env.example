# ── Channels ─────────────────────────────────────────────────────────────────
# Without one of these, messages queue and nothing sends. `dun outbox` will say so.

# Email over SMTP. Port 465 is implicit TLS; 587 upgrades with STARTTLS.
# Use an app password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_HELO=
SMTP_SUBJECT=

# WhatsApp via Meta's official Cloud API.
# A free-form message is only allowed inside the 24h customer service window;
# outside it Meta requires a pre-approved template.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Anything else, over HTTP. Receives { to, body, idempotencyKey }; 2xx = delivered.
CHANNEL_WEBHOOK_URL=
CHANNEL_WEBHOOK_TOKEN=

# ── Delivery ────────────────────────────────────────────────────────────────
# Attempts before a message is declared dead and surfaced by `dun outbox`.
DUN_MAX_SEND_ATTEMPTS=5

# ── Storage ─────────────────────────────────────────────────────────────────
DUN_DB=data/dun.db
