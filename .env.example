# ── Channels ────────────────────────────────────────────────────────────────
# Without one of these, messages queue and nothing sends. `dun outbox` says so.

# Email over SMTP. 465 is implicit TLS; 587 upgrades with STARTTLS.
# Use an app password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_HELO=
SMTP_SUBJECT=

# WhatsApp via Meta's official Cloud API. A free-form message is only allowed
# inside the 24h customer service window; outside it Meta requires a template.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Anything else, over HTTP. Receives { to, body, idempotencyKey }; 2xx = delivered.
CHANNEL_WEBHOOK_URL=
CHANNEL_WEBHOOK_TOKEN=

# ── Durable storage ─────────────────────────────────────────────────────────
# Free hosts give you an ephemeral disk: the ledger is gone on the next restart.
# These three keep an encrypted copy in a private git repo and restore it at boot.
#
#   DUN_BACKUP_REPO   owner/private-repo
#   DUN_BACKUP_TOKEN  a fine-grained PAT with contents:write on that repo only
#   DUN_BACKUP_KEY    a long passphrase (24+ chars) — without it the snapshot is
#                     useless, so store it somewhere you will not lose
DUN_BACKUP_REPO=
DUN_BACKUP_TOKEN=
DUN_BACKUP_KEY=

# ── Delivery ────────────────────────────────────────────────────────────────
DUN_MAX_SEND_ATTEMPTS=5

# ── Storage ─────────────────────────────────────────────────────────────────
DUN_DB=data/dun.db
PORT=3000
